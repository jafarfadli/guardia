# Ghostty, dressed as the room: ink on old paper by day, by lamplight at night.
theme = light:Kertas,dark:Kertas Malam
font-family = FantasqueSansM Nerd Font Mono
font-size = 15
adjust-cell-height = 8%
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-theme = auto
macos-titlebar-style = tabs
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
