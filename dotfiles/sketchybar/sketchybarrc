#!/bin/bash
# Kamar menu bar: paper tags inked by hand, hanging over the room's ceiling.
# The centre stays empty for the island. Windows sit above the bar (topmost=off),
# so a maximised window simply covers it; the macOS menu bar still slides down on hover.

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
source "$CONFIG_DIR/colors.sh"
PLUGINS="$CONFIG_DIR/plugins"
ICONS="$CONFIG_DIR/icons"

sketchybar --bar position=top height=34 color=$TRANSPARENT topmost=off sticky=on \
                 padding_left=10 padding_right=10 y_offset=2 display=main

# a paper tag: cream fill, ink border, one hard blue-grey step of shadow straight down
TAG=(
  background.drawing=on
  background.color=$PAPER
  background.border_color=$INK
  background.border_width=2
  background.corner_radius=8
  background.height=24
  background.shadow.drawing=on
  background.shadow.color=$SHADOW
  background.shadow.angle=90
  background.shadow.distance=3
)

default=(
  padding_left=3
  padding_right=3
  icon.font="$FONT:Bold:13.0"
  label.font="$FONT:Bold:13.0"
  icon.color=$INK
  label.color=$INK
  icon.padding_left=6
  icon.padding_right=2
  label.padding_left=4
  label.padding_right=8
  background.height=24
)
sketchybar --default "${default[@]}"

# icon-only item showing a PNG drawn in ink (22 pt, rendered at 2x)
icon_item() { # name position image
  sketchybar --add item "$1" "$2" \
             --set "$1" icon.drawing=off label.drawing=off width=24 \
                        background.drawing=on background.color=$TRANSPARENT \
                        background.image="$3" background.image.drawing=on background.image.scale=0.5 \
                        background.padding_left=6 background.padding_right=0
}

# ---------------------------------------------------------------- left
icon_item kamar left "$ICONS/cat.png"
sketchybar --set kamar click_script="open -g 'kamar://pet/come'"
sketchybar --add item kamar.name left \
           --set kamar.name icon.drawing=off label="kamar" label.padding_left=2 label.padding_right=10 \
           --add bracket kamar.tag kamar kamar.name \
           --set kamar.tag "${TAG[@]}"

for sid in 1 2 3 4 5 6; do
  sketchybar --add space space.$sid left \
             --set space.$sid space=$sid icon="$sid" icon.padding_left=8 icon.padding_right=8 label.drawing=off \
                   background.drawing=on background.color=$TRANSPARENT background.corner_radius=6 background.height=18 \
                   script="$PLUGINS/space.sh"
done
sketchybar --add bracket spaces '/space\..*/' --set spaces "${TAG[@]}"

sketchybar --add item front_app left \
           --set front_app icon.drawing=off label.padding_left=10 label.padding_right=10 script="$PLUGINS/front_app.sh" \
                 "${TAG[@]}" \
           --subscribe front_app front_app_switched

# ---------------------------------------------------------------- right (added right to left)
sketchybar --add item clock right \
           --set clock icon.drawing=off label.padding_left=10 label.padding_right=10 update_freq=15 script="$PLUGINS/clock.sh" "${TAG[@]}" \
           --subscribe clock system_woke

icon_item battery.icon right "$ICONS/battery-4.png"
sketchybar --add item battery right \
           --set battery icon.drawing=off label.padding_left=2 update_freq=120 script="$PLUGINS/battery.sh" \
           --subscribe battery power_source_change system_woke
sketchybar --move battery.icon before battery 2>/dev/null
sketchybar --add bracket battery.tag battery battery.icon --set battery.tag "${TAG[@]}"

icon_item weather.icon right "$ICONS/partly.png"
sketchybar --add item weather right \
           --set weather icon.drawing=off label.padding_left=2 update_freq=900 script="$PLUGINS/weather.sh" \
           --subscribe weather system_woke
sketchybar --move weather.icon before weather 2>/dev/null
sketchybar --add bracket weather.tag weather weather.icon --set weather.tag "${TAG[@]}"

# hidden: follows the system appearance (light paper / kertas malam)
sketchybar --add event kamar_appearance \
           --add item appearance left \
           --set appearance drawing=off update_freq=20 script="$PLUGINS/appearance.sh" \
           --subscribe appearance system_woke
sketchybar --subscribe battery kamar_appearance --subscribe weather kamar_appearance

sketchybar --update
